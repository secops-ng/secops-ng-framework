# SecOps-NG runtime configuration — PLACEHOLDERS ONLY.
# Copy to `.env` and fill in for local development.
# In production, inject these via your platform's secret manager or vault.
# Never commit a populated `.env` file.

# --- Temporal ---------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=secops-ng

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO

# --- Optional LLM backends --------------------------------------------------
# These are optional and MUST be injected at runtime (env var or vault).
# Leave commented out unless you are using the corresponding backend.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Sovereignty hints ------------------------------------------------------
# Pin SecOps-NG to an EU-resident inference endpoint when running under
# NIS2 / sovereignty constraints. Leave empty to use SDK defaults.
# LLM_BASE_URL=
# LLM_REGION=
