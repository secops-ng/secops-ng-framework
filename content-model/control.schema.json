{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secops-ng.org/schemas/content-model/control.schema.json",
  "title": "SecOps-NG Control Binding",
  "description": "A control binding pairs an OSCAL component-definition fragment (the WHAT we claim to control) with a MITRE D3FEND defensive technique (the HOW we counter the adversary). SecOps-NG does NOT fork OSCAL or D3FEND; we reference and overlay the upstream IDs and join into the playbook, detection, and telemetry layers via the shared `stable_id` shape.",
  "type": "object",
  "required": ["stable_id", "content_version", "maturity", "title", "oscal", "d3fend"],
  "additionalProperties": false,
  "properties": {
    "stable_id": {
      "description": "SecOps-NG stable identifier for this control. Namespace convention: `control.<slug>@v<semver>` — for example `control.edr_script_block_logging@v1`. Same lexical shape as the playbook schema's stable_id so any layer can cross-reference any other.",
      "allOf": [
        { "$ref": "#/$defs/stable_id" },
        { "pattern": "^control\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@v[0-9]+(\\.[0-9]+){0,2}$" }
      ]
    },
    "content_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of this control content artifact."
    },
    "maturity": {
      "type": "string",
      "enum": ["draft", "experimental", "stable", "deprecated"]
    },
    "title":   { "type": "string", "maxLength": 200 },
    "summary": {
      "type": "string",
      "description": "One-paragraph operator-facing description of the control intent."
    },
    "oscal": {
      "type": "object",
      "description": "OSCAL component-definition fragment. Mirrors the shape of NIST OSCAL `component` so consumers can lift this into a full component-definition without translation.",
      "required": ["component"],
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "object",
          "required": ["uuid", "type", "title", "control-implementations"],
          "additionalProperties": false,
          "properties": {
            "uuid": {
              "type": "string",
              "format": "uuid",
              "description": "OSCAL component UUID. Stable across the component's lifetime."
            },
            "type": {
              "type": "string",
              "enum": ["software", "hardware", "service", "policy", "physical", "process-procedure", "plan", "guidance", "standard", "validation"]
            },
            "title":       { "type": "string" },
            "description": { "type": "string" },
            "purpose":     { "type": "string" },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "value"],
                "properties": {
                  "name":  { "type": "string" },
                  "value": { "type": "string" },
                  "ns":    { "type": "string", "format": "uri" }
                }
              }
            },
            "control-implementations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["uuid", "source", "description", "implemented-requirements"],
                "additionalProperties": false,
                "properties": {
                  "uuid": { "type": "string", "format": "uuid" },
                  "source": {
                    "type": "string",
                    "format": "uri",
                    "description": "URI of the source catalog or profile (e.g. NIST 800-53 Rev5, ISO 27001 Annex A, NIS2 Article 21)."
                  },
                  "description": { "type": "string" },
                  "implemented-requirements": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["uuid", "control-id", "description"],
                      "properties": {
                        "uuid":       { "type": "string", "format": "uuid" },
                        "control-id": {
                          "type": "string",
                          "description": "Catalog control identifier, e.g. ac-2 (NIST), A.5.16 (ISO 27001), nis2-art21-d (community)."
                        },
                        "description": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "d3fend": {
      "type": "object",
      "description": "MITRE D3FEND defensive technique pointer.",
      "required": ["technique_id"],
      "additionalProperties": false,
      "properties": {
        "technique_id": {
          "type": "string",
          "pattern": "^D3-[A-Z0-9]+$",
          "description": "D3FEND technique ID, e.g. D3-NTA (Network Traffic Analysis)."
        },
        "technique_name": { "type": "string" },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Canonical D3FEND URL, e.g. https://d3fend.mitre.org/technique/d3f:NetworkTrafficAnalysis/."
        }
      }
    },
    "attack_counters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      },
      "uniqueItems": true,
      "description": "MITRE ATT&CK technique IDs this control is designed to counter (e.g. T1059.001)."
    },
    "detected_by": {
      "description": "Detection stable IDs that supply runtime evidence this control is operating. Joins to detection.schema.json#stable_id.",
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/stable_id" },
          { "pattern": "^detection\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@v[0-9]+(\\.[0-9]+){0,2}$" }
        ]
      },
      "uniqueItems": true
    },
    "telemetry_refs": {
      "description": "Telemetry stable IDs whose payloads provide attestation evidence for this control. Joins to telemetry.schema.json#stable_id.",
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/stable_id" },
          { "pattern": "^telemetry\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@v[0-9]+(\\.[0-9]+){0,2}$" }
        ]
      },
      "uniqueItems": true
    },
    "playbook_refs": {
      "description": "Playbooks (optionally specific CACAO step names) that operationalise this control.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["playbook_id"],
        "additionalProperties": false,
        "properties": {
          "playbook_id": {
            "allOf": [
              { "$ref": "#/$defs/stable_id" },
              { "pattern": "^playbook\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@v[0-9]+(\\.[0-9]+){0,2}$" }
            ]
          },
          "step_id": { "type": "string" }
        }
      },
      "uniqueItems": true
    },
    "maintainer": { "type": "string" },
    "sources": {
      "description": "Free-form provenance pointers — regulatory clauses, vendor advisories, community profiles — that motivated this control. Plain text only; no internal infra references.",
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "stable_id": {
      "description": "SecOps-NG stable identifier (shared shape across all content-model layers).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*@v[0-9]+(\\.[0-9]+){0,2}$"
    }
  }
}
