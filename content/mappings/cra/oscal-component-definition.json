    "metadata": {
      "title": "SecOps-NG \u2014 CRA Vulnerability Handling & Reporting Component Definition (SKELETON)",
      "last-modified": "2026-06-01T00:00:00Z",
      "version": "0.1.0",
      "oscal-version": "1.1.2"
    },
    "components": [
      {
        "uuid": "087ee99e-81b6-5cb3-ab3e-eb688e2bc11d",
        "type": "process-procedure",
        "title": "SecOps-NG",
        "description": "SecOps-NG is a community-driven Digital Commons of portable security operations content (CACAO playbooks, OSCAL/D3FEND control mappings, OCSF data shapes, KPI/KRI catalog) plus reference compilers to n8n, Temporal, and LangGraph. This component definition exposes how the SecOps-NG content set addresses the CRA essential cybersecurity requirements for vulnerability handling (Annex I \u00a72) and the manufacturer reporting obligations to the coordinator CSIRT and ENISA (Article 14).",
        "control-implementations": [
          {
            "uuid": "89952745-7122-5bb4-bf12-88a64c47a7c6",
            "source": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj",
            "description": "Coverage of CRA (Regulation (EU) 2024/2847) Annex I \u00a72 vulnerability-handling essential requirements (SBOM, vulnerability handling, coordinated vulnerability disclosure policy, security update dissemination) and Article 14 reporting obligations to the coordinator CSIRT and ENISA (early-warning, 72-hour notification, final report, severe-incident notification), as mapped in content/mappings/cra/article-14-and-annex-i.yaml.",
            "implemented-requirements": [
              {
                "uuid": "0f737ee9-bb31-56b6-9b7d-1b46ffb682b4",
                "control-id": "control.sbom_capture-v1",
                "description": "Identify and document vulnerabilities and components contained in the product with digital elements, including by drawing up a software bill of materials in a commonly used and machine-readable format that covers at the very least the top-level dependencies.",
                "props": [
                  {
                    "name": "source-control-ref",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "control.sbom_capture@v1"
                  },
                  {
                    "name": "source-entry-id",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "cra:annex-i-2-sbom"
                  },
                  {
                    "name": "source-article",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "Annex I \u00a72(1)"
                  }
                ]
              },
              {
                "uuid": "3aaf1395-83f9-5164-800f-70a62bf66625",
                "control-id": "control.vuln_disclosure_intake-v1",
                "description": "Address and remediate vulnerabilities without delay, including by providing security updates, and document the vulnerability-handling process throughout the support period.",
                "props": [
                  {
                    "name": "source-control-ref",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "control.vuln_disclosure_intake@v1"
                  },
                  {
                    "name": "source-entry-id",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "cra:annex-i-2-vuln-handling"
                  },
                  {
                    "name": "source-article",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "Annex I \u00a72(2)"
                  }
                ]
              },
              {
                "uuid": "c553315c-3359-5abb-b22f-d776f61d79d0",
                "control-id": "control.vuln_disclosure_intake-v1",
                "description": "Put in place and enforce a coordinated vulnerability disclosure policy, including a single point of contact for the receipt of information on vulnerabilities from any source.",
                "props": [
                  {
                    "name": "source-control-ref",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "control.vuln_disclosure_intake@v1"
                  },
                  {
                    "name": "source-entry-id",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "cra:annex-i-2-cvd-policy"
                  },
                  {
                    "name": "source-article",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "Annex I \u00a72(5)"
                  }
                ]
              },
              {
                "uuid": "ab5b93c1-5e3c-5bf8-b7b2-8d9915f914e7",
                "control-id": "control.patch_evidence-v1",
                "description": "Ensure that, where technically feasible, security updates are disseminated without delay and free of charge for the duration of the support period, accompanied by advisory messages providing users with the relevant information.",
                "props": [
                  {
                    "name": "source-control-ref",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "control.patch_evidence@v1"
                  },
                  {
                    "name": "source-entry-id",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "cra:annex-i-2-security-updates"
                  },
                  {
                    "name": "source-article",
                    "ns": "https://secops-ng.org/ns/oscal",
                    "value": "Annex I \u00a72(7)"
                  }
                ]
              },
              {
