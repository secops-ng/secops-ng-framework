    },
    "components": [
      {
        "uuid": "08cd3077-b5ab-511e-aedd-ac510f47b754",
        "type": "process-procedure",
        "title": "SecOps-NG",
        "description": "SecOps-NG is a community-driven Digital Commons of portable security operations content (CACAO playbooks, OSCAL/D3FEND control mappings, OCSF data shapes, KPI/KRI catalog) plus reference compilers to n8n, Temporal, and LangGraph. This component definition exposes how the SecOps-NG content set addresses the DORA ICT risk-management framework (Chapter II) and ICT-related incident management, classification, and reporting (Chapter III) obligations.",
        "control-implementations": [
          {
            "uuid": "f2b1f61f-8172-543d-8bf5-81f831d9ae2a",
            "source": "https://eur-lex.europa.eu/eli/reg/2022/2554/oj",
            "description": "Coverage of DORA (Regulation (EU) 2022/2554) Article 5 governance and organisation, Article 6 ICT risk-management framework, Article 9 vulnerability and patch management obligations, and Articles 18\u201319 ICT-related incident classification and reporting obligations, as mapped in content/mappings/dora/article-5.yaml, article-6.yaml, article-9-and-rts-vuln-mgmt.yaml, and article-19-and-28.yaml. Third-party-risk obligations (Articles 28+) are out of scope for this skeleton.",
            "implemented-requirements": [
              {
                "uuid": "bf11bced-760e-516b-9adb-b0d379f06f8d",
                "control-id": "control.ict_risk_governance-v1",
                "description": "Establish an internal governance and control framework that ensures effective and prudent management of ICT risk, with the management body bearing ultimate responsibility for the ICT risk-management framework, setting roles and responsibilities for ICT functions, and approving and reviewing the framework at least annually.",
