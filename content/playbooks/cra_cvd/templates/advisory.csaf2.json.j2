{# Advisory template — CSAF 2.0 machine-readable emission.
   Rendered by the publish_advisory step of playbook.cra_cvd@v1 alongside
   the human-readable Markdown form in advisory.md.j2.

   CSAF 2.0 spec: OASIS Common Security Advisory Framework v2.0
     https://docs.oasis-open.org/csaf/csaf/v2.0/csaf-v2.0.html

   Fields (superset of advisory.md.j2):
     advisory_id         : operator-issued advisory id.
     cve_id              : CVE identifier when assigned; omit block when empty.
     title               : one-line summary.
     summary             : 1–3 sentence executive summary.
     affected_products   : list of {product_id, product_name,
                                    branches:[{version, status}]}.
     severity_cvss_v4    : full CVSS v4.0 vector string.
     severity_score      : numeric base score (0.0 – 10.0).
     severity_label      : NONE / LOW / MEDIUM / HIGH / CRITICAL.
     impact              : plain-English impact statement.
     mitigations         : list of mitigation strings; may be empty.
     fix_reference       : release / build id.
     credit_display      : reporter credit line, or the anonymous
                           marker when the reporter has not consented
                           via reporter-credit consent capture on the
                           coordinate_disclosure step.
     disclosure_date_iso : ISO 8601 date the advisory becomes public.
     operator_display    : publisher name.
     operator_namespace  : publisher namespace (RFC 3986 URI).
     tracking_status     : "final" for coordinated release; "interim"
                           for a partial disclosure held on operator
                           discretion.

   The emitted document is a valid CSAF 2.0 `csaf_security_advisory`
   profile instance. Compile targets serialise this Jinja2 render as
   JSON with a stable key order (sorted keys) for byte-parity.
#}
{
  "document": {
    "category": "csaf_security_advisory",
    "csaf_version": "2.0",
    "title": {{ title | tojson }},
    "publisher": {
      "category": "vendor",
      "name": {{ operator_display | tojson }},
      "namespace": {{ operator_namespace | tojson }}
    },
    "tracking": {
      "id": {{ advisory_id | tojson }},
      "status": {{ tracking_status | tojson }},
      "version": "1",
      "initial_release_date": {{ disclosure_date_iso | tojson }},
      "current_release_date": {{ disclosure_date_iso | tojson }},
      "revision_history": [
        {
          "date": {{ disclosure_date_iso | tojson }},
          "number": "1",
          "summary": "Initial coordinated release."
        }
      ]
    },
    "distribution": {
      "tlp": {"label": "WHITE"}
    },
    "notes": [
      {"category": "summary", "text": {{ summary | tojson }}},
      {"category": "general", "text": {{ impact | tojson }}}
    ]
  },
  "product_tree": {
    "branches": [
      {%- for row in affected_products %}
      {
        "category": "product_name",
        "name": {{ row.product_name | tojson }},
        "branches": [
          {%- for br in row.branches %}
          {
            "category": "product_version",
            "name": {{ br.version | tojson }},
            "product": {
              "product_id": {{ (row.product_id ~ ":" ~ br.version) | tojson }},
              "name": {{ (row.product_name ~ " " ~ br.version) | tojson }}
            }
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ]
      }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  },
  "vulnerabilities": [
    {
      "title": {{ title | tojson }},
      {% if cve_id %}"cve": {{ cve_id | tojson }},{% endif %}
      "notes": [
        {"category": "description", "text": {{ summary | tojson }}},
        {"category": "details", "text": {{ impact | tojson }}}
      ],
      "product_status": {
        "known_affected": [
          {%- for row in affected_products -%}
          {%- for br in row.branches -%}
          {%- if br.status == "affected" -%}
          {{ (row.product_id ~ ":" ~ br.version) | tojson }}{% if not loop.last %},{% endif %}
          {%- endif -%}
          {%- endfor -%}
          {%- endfor %}
        ],
        "fixed": [
          {%- for row in affected_products -%}
          {%- for br in row.branches -%}
          {%- if br.status == "fixed" -%}
          {{ (row.product_id ~ ":" ~ br.version) | tojson }}{% if not loop.last %},{% endif %}
          {%- endif -%}
          {%- endfor -%}
          {%- endfor %}
        ]
      },
      "scores": [
        {
          "cvss_v4": {
            "version": "4.0",
            "vectorString": {{ severity_cvss_v4 | tojson }},
            "baseScore": {{ severity_score }},
            "baseSeverity": {{ severity_label | tojson }}
          },
          "products": [
            {%- for row in affected_products -%}
            {%- for br in row.branches -%}
            {%- if br.status == "affected" -%}
            {{ (row.product_id ~ ":" ~ br.version) | tojson }}{% if not loop.last %},{% endif %}
            {%- endif -%}
            {%- endfor -%}
            {%- endfor %}
          ]
        }
      ],
      "remediations": [
        {
          "category": "vendor_fix",
          "details": {{ fix_reference | tojson }},
          "product_ids": [
            {%- for row in affected_products -%}
            {%- for br in row.branches -%}
            {%- if br.status == "fixed" -%}
            {{ (row.product_id ~ ":" ~ br.version) | tojson }}{% if not loop.last %},{% endif %}
            {%- endif -%}
            {%- endfor -%}
            {%- endfor %}
          ]
        }{% if mitigations %},
        {% for m in mitigations %}
        {
          "category": "workaround",
          "details": {{ m | tojson }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
        {% endif %}
      ],
      "acknowledgments": [
        {"summary": {{ credit_display | tojson }}}
      ]
    }
  ]
}
