              "type": "string"
            },
            {
              "id": "in.timeline_artifact",
              "name": "in.timeline_artifact",
              "value": "={{$workflow.variables.timeline_artifact}}",
              "type": "string"
            },
            {
              "id": "in.evidence_gaps_present",
              "name": "in.evidence_gaps_present",
              "value": "={{$workflow.variables.evidence_gaps_present}}",
              "type": "string"
            },
            {
              "id": "out.review_artifact",
              "name": "out.review_artifact",
              "value": "",
              "type": "string"
            },
            {
              "id": "x_secops_ng.control_refs",
              "name": "x_secops_ng.control_refs",
              "value": "control.blameless_review@v1",
              "type": "string"
            },
            {
              "id": "x_secops_ng.telemetry_refs",
              "name": "x_secops_ng.telemetry_refs",
              "value": "telemetry.ocsf.incident_finding@v1",
              "type": "string"
            },
            {
              "id": "x_secops_ng.metric_refs",
              "name": "x_secops_ng.metric_refs",
              "value": "kpi.review_completion_sla@v1",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "notes": "Walk the operator's blameless review template against the collated timeline. The template separates contributing factors (process, tooling, staffing, training, environment) from individual error, and explicitly captures decisions that were reasonable given the evidence available at the time. If __evidence_gaps_present__ is true the template's evidence-gaps section is mandatory rather than optional. Produces __review_artifact__.",
      "notesInFlow": true
    },
    {
