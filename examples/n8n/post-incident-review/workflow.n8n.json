              "type": "string",
              "value": "",
              "description": "Identifier of the closed/contained incident this review is being run against. External input."
            },
            {
              "name": "__timeline_artifact__",
              "type": "string",
              "value": "",
              "description": "Reference to the collated timeline artifact (path, document ID, or URI) produced by the timeline-collation step."
            },
            {
              "name": "__evidence_gaps_present__",
              "type": "boolean",
              "value": "",
              "description": "Whether the timeline collation step detected gaps in the evidence record \u2014 cleared eventlogs, disabled audit policy, timestomped files, or any of the anti-forensics signals enumerated in external_references. Gaps are recorded in the review without blocking it; the review template explicitly addresses how decisions were made under partial evidence."
            },
            {
              "name": "__review_artifact__",
              "type": "string",
              "value": "",
              "description": "Reference to the completed blameless-review document (path, document ID, or URI) produced by the review-template step."
