              "type": "string"
            },
            {
              "id": "out.corrective_action_register",
              "name": "out.corrective_action_register",
              "value": "",
              "type": "string"
            },
            {
              "id": "x_secops_ng.control_refs",
              "name": "x_secops_ng.control_refs",
              "value": "control.corrective_action_register@v1",
              "type": "string"
            },
            {
              "id": "x_secops_ng.telemetry_refs",
