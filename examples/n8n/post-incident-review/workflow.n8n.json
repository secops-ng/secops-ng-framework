              "name": "__corrective_action_register__",
              "type": "string",
              "value": "",
              "description": "Reference to the corrective-action register entry (path, ticket ID, or URI) produced by the corrective-action-tracking step. Holds owner, due-date, and verification clause for each action item."
            }
          ]
        }
      },
      "notes": "",
      "notesInFlow": false
    },
    {
      "id": "action--40000000-0000-4000-8000-000000000002",
      "name": "timeline collation",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        420
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "in.incident_id",
              "name": "in.incident_id",
              "value": "={{$workflow.variables.incident_id}}",
              "type": "string"
